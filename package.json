{
  "name": "erpnext-pw-cucumber",
  "version": "1.0.0",
  "description": "playwright cucumber framework TS",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags '@smoke'",
