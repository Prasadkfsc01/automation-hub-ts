    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "pg": "^8.23.1",
    "playwright": "^1.63.0"
  }
}
